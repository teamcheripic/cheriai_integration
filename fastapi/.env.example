# =============================================================================
# CheriPic AI Backend — environment template
# =============================================================================
# Local: copy to .env and fill in.
# Railway: set these under the service's Variables tab (do NOT commit .env).
# =============================================================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-server-side-secret-key

# OpenAI — llm_client.py falls back to "[MOCK LLM] ..." if unset
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Server — Railway injects PORT; leave unset there
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated, no spaces
FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=

# Ops
RATE_LIMIT=60/minute
LOG_LEVEL=INFO
ENVIRONMENT=production
